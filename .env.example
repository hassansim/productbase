# Server Port (optional, defaults to 5000)
PORT=5000

# MongoDB Connection String:
# 1. Leave blank or commented out to automatically run with the embedded in-memory MongoDB (zero setup required).
# 2. Or paste your free MongoDB Atlas URI below:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/products_db?retryWrites=true&w=majority
